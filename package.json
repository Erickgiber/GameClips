{
	"name": "gameclips-monorepo",
	"private": true,
	"version": "0.0.1",
	"scripts": {
		"dev": "concurrently -n FE,BE -c cyan,magenta \"npm run dev:frontend\" \"npm run dev:backend\"",
		"dev:frontend": "npm -w frontend run dev",
		"dev:backend": "npm -w backend run dev",
		"build": "npm -w frontend run build",
		"build:backend": "npm -w backend run build",
		"install:all": "npm install",
		"lint": "npm -w frontend run lint",
		"format": "npm -w frontend run format"
	},
	"workspaces": [
		"frontend",
		"backend"
	],
	"devDependencies": {
		"concurrently": "^9.1.2"
	}
}
